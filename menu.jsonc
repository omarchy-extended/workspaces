{
  // The omarchy-extended group, in Setup (every omext addon has it; any one keeps it).
  "setup.omext": {"icon": "", "label": "Omarchy Extended", "description": "The omarchy-extended addons, on or off", "aliases": ["omext", "extended"]},
  // The workspace widget: omext's, or Omarchy's own back.
  "setup.omext.workspaces": {"icon": "󰕰", "label": "Workspaces", "description": "The bar's workspaces keep out of the way: the first, and another only while something is on it", "action": "f=\"$HOME/.config/omarchy/shell.json\"; if grep -q '\"omext.workspaces\"' \"$f\"; then from=omext.workspaces; to=omarchy.workspaces; m=\"Turned off: Omarchy's workspaces are back on the bar\"; else from=omarchy.workspaces; to=omext.workspaces; m=\"Turned on\"; fi; jq --arg from \"$from\" --arg to \"$to\" '(.bar.layout[]?[]? | select(.id == $from) | .id) = $to' \"$f\" > \"$f.tmp\" && mv \"$f.tmp\" \"$f\"; notify-send Workspaces \"$m\"", "checked": "grep -q '\"omext.workspaces\"' \"$HOME/.config/omarchy/shell.json\""},
  "setup.omext.workspaces-five": {"icon": "󰎱", "label": "Workspaces: Always Show 1 to 5", "description": "Off: only the first is always there, the rest while something is on them", "action": "if [ \"$(omext-settings get workspaces always | tr -d ' \\n')\" = '[1,2,3,4,5]' ]; then omext-settings set workspaces always '[1]'; m=\"Only the first always shows\"; else omext-settings set workspaces always '[1,2,3,4,5]'; m=\"1 to 5 always show\"; fi; notify-send Workspaces \"$m\"", "when": "grep -q '\"omext.workspaces\"' \"$HOME/.config/omarchy/shell.json\"", "checked": "[ \"$(omext-settings get workspaces always | tr -d ' \\n')\" = '[1,2,3,4,5]' ]"},
  "setup.omext.workspaces-scroll": {"icon": "󱕒", "label": "Workspaces: Scroll on the Bar Switches", "description": "A scroll over the bar's workspace numbers goes to the next or the one before", "action": "if [ \"$(omext-settings toggle workspaces scroll)\" = true ]; then m=\"Turned on\"; else m=\"Turned off\"; fi; notify-send Workspaces \"Scroll on the bar: $m\"", "when": "grep -q '\"omext.workspaces\"' \"$HOME/.config/omarchy/shell.json\"", "checked": "omext-settings get workspaces scroll >/dev/null"},
  "setup.omext.workspaces-super-scroll": {"icon": "󰍽", "label": "Workspaces: Super + Scroll Switches", "description": "Super held and the scroll wheel go to the next workspace or the one before (Omarchy's own keys)", "action": "if [ \"$(omext-settings toggle workspaces superScroll)\" = true ]; then m=\"Turned on\"; else m=\"Turned off\"; fi; hyprctl reload >/dev/null; notify-send Workspaces \"Super + scroll: $m\"", "when": "grep -q '\"omext.workspaces\"' \"$HOME/.config/omarchy/shell.json\"", "checked": "omext-settings get workspaces superScroll >/dev/null"}
}
